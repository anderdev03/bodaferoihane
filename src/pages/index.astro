---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Location from '../components/Location.astro'
import Itinerary from '../components/Itinerary.astro'
import BusSection from '../components/BusSection.astro'
import GiftSection from '../components/GiftSection.astro'
import RsvpForm from '../components/RsvpForm.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
    <Hero title="Oihane &amp; Fer" subtitle="¡Nos casamos!" date="11 de octubre de 2026" targetDate="2026-10-11" />
    <Location name="Señorío de Beraiz" />
    <Itinerary />
    <BusSection />
    <GiftSection />
    <section id="rsvp" class="bg-warm px-4 py-16 sm:py-24">
        <div class="mx-auto max-w-xl text-center" data-animate>
            <p class="font-serif text-sm uppercase tracking-[0.3em] text-muted">Confirmación</p>
            <h2 class="mt-3 font-serif text-3xl font-normal sm:text-4xl">¿Vienes?</h2>
            <p class="mt-4 text-muted">Confirma tu asistencia antes del <strong>30 de septiembre</strong></p>
            <div class="mt-10">
                <RsvpForm />
            </div>
        </div>
    </section>
    <Footer />
</Layout>
