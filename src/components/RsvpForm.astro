---
const GAS_URL = import.meta.env.PUBLIC_GAS_URL

const busGroups = [
    {
        label: 'Solo ida',
        options: [
            { label: 'Salida desde Noáin', value: 'Ida - Salida desde Noáin' },
            { label: 'Salida desde Burlada', value: 'Ida - Salida desde Burlada' },
        ],
    },
    {
        label: 'Ida y vuelta',
        options: [
            { label: 'Salida desde Noáin', value: 'Ida y vuelta - Salida desde Noáin' },
            { label: 'Salida desde Burlada', value: 'Ida y vuelta - Salida desde Burlada' },
        ],
    },
]

const busExtra = [
    {
        label: 'Otras opciones',
        options: [
            { label: 'Solo vuelta', value: 'Solo vuelta' },
            { label: 'No cogeré el autobús', value: 'No cogeré el autobús' },
        ],
    },
]
---

<form id="rsvp-form" class="mx-auto max-w-xl text-left" data-gas={GAS_URL}>
    <div class="space-y-6">
        <div>
            <label class="mb-1 block text-sm text-muted">¿Asistirás?</label>
            <div class="flex gap-4">
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-accent-light/40 px-5 py-3 text-sm transition has-checked:border-accent has-checked:bg-accent/5">
                    <input type="radio" name="asiste" value="SI" required />
                    Sí, asistiré
                </label>
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-accent-light/40 px-5 py-3 text-sm transition has-checked:border-accent has-checked:bg-accent/5">
                    <input type="radio" name="asiste" value="NO" required />
                    No, lo siento
                </label>
            </div>
        </div>

        <div>
            <label for="nombre" class="mb-1 block text-sm text-muted">Nombre y apellidos</label>
            <input type="text" id="nombre" name="nombre" required
                class="w-full rounded-lg border border-accent-light/40 bg-cream px-4 py-3 text-sm outline-none transition focus:border-accent" />
        </div>

        <div>
            <label class="mb-1 block text-sm text-muted">Alergias / Intolerancias</label>
            <div class="space-y-2">
                {['Vegetariano', 'Vegano', 'Celíaco'].map((opt) => (
                    <label class="flex cursor-pointer items-center gap-2 text-sm">
                        <input type="checkbox" name="alergias" value={opt}
                            class="appearance-none size-4 shrink-0 cursor-pointer rounded-full border border-accent-light bg-white transition checked:border-accent checked:bg-accent" />
                        {opt}
                    </label>
                ))}
            </div>
        </div>

        <div>
            <label for="otros" class="mb-1 block text-sm text-muted">Otras alergias o intolerancias</label>
            <input type="text" id="otros" name="otros_texto"
                class="w-full rounded-lg border border-accent-light/40 bg-cream px-4 py-3 text-sm outline-none transition focus:border-accent" />
        </div>

        <div>
            <label class="mb-4 block text-sm text-muted">¿Coges el autobús?</label>
            <div class="space-y-4">
                {busGroups.map((group) => (
                    <div>
                        <p class="mb-1.5 text-xs font-medium uppercase tracking-widest text-muted">{group.label}</p>
                        <div class="space-y-2">
                            {group.options.map((opt) => (
                                <label class="flex cursor-pointer items-center gap-2 text-sm">
                                        <input type="checkbox" name="bus" value={opt.value}
                                            class="appearance-none size-4 shrink-0 cursor-pointer rounded-full border border-accent-light bg-white transition checked:border-accent checked:bg-accent" />
                                    {opt.label}
                                </label>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
            <div class="mt-5 border-t border-accent-light/40 pt-4">
                <div class="space-y-4">
                    {busExtra.map((group) => (
                        <div>
                            <p class="mb-1.5 text-xs font-medium uppercase tracking-widest text-muted">{group.label}</p>
                            <div class="space-y-2">
                                {group.options.map((opt) => (
                                    <label class="flex cursor-pointer items-center gap-2 text-sm">
                                    <input type="checkbox" name="bus" value={opt.value}
                                        class="appearance-none size-4 shrink-0 cursor-pointer rounded-full border border-accent-light bg-white transition checked:border-accent checked:bg-accent" />
                                        {opt.label}
                                    </label>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            <p id="bus-error" class="mt-2 hidden text-sm text-red-600">Selecciona una opción de autobús</p>
        </div>

        <button type="submit"
            class="btn-accent w-full">
            Confirmar asistencia
        </button>
    </div>
</form>

<div id="rsvp-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-dark/50 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-xl bg-white p-8 text-center shadow-xl">
        <p class="font-serif text-2xl text-accent">¡Gracias por confirmar!</p>
        <p class="mt-2 text-sm text-muted">Te esperamos ❤️</p>
        <button id="rsvp-modal-close" class="btn-accent mt-6 w-full">Cerrar</button>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('rsvp-form')
        if (!form) return
        const gasUrl = form.dataset.gas
        const modal = document.getElementById('rsvp-modal')

        function closeModal() {
            modal.classList.add('hidden')
            modal.classList.remove('flex')
            form.reset()
            window.location.reload()
        }
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal()
        })
        document.getElementById('rsvp-modal-close').addEventListener('click', closeModal)

        const busCheckboxes = form.querySelectorAll('input[name="bus"]')
        busCheckboxes.forEach((cb) => {
            cb.addEventListener('change', () => {
                if (cb.checked) {
                    busCheckboxes.forEach((o) => {
                        if (o !== cb) o.checked = false
                    })
                }
            })
        })

        form.addEventListener('submit', async (e) => {
            e.preventDefault()
            const fd = new FormData(form)
            const busError = document.getElementById('bus-error')
            if (fd.get('asiste') === 'SI' && !fd.get('bus')) {
                busError.classList.remove('hidden')
                return
            }
            busError.classList.add('hidden')
            const alergias = fd.getAll('alergias')
            const payload = {
                nombre: fd.get('nombre'),
                asiste: fd.get('asiste'),
                alergias,
                otros_texto: fd.get('otros_texto'),
                bus: fd.get('bus'),
            }

            const btn = form.querySelector('button[type="submit"]')
            btn.disabled = true
            btn.textContent = 'Enviando...'

            try {
                await fetch(gasUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain' },
                    body: JSON.stringify(payload),
                })
                modal.classList.remove('hidden')
                modal.classList.add('flex')
            } catch {
                btn.disabled = false
                btn.textContent = 'Error — inténtalo de nuevo'
            }
        })
    })()
</script>
