---
const trips = [
    {
        title: 'Ida',
        stops: [
            { time: '12:15', label: 'Noáin', place: 'Ayuntamiento del Valle de Elorz, Pl. de los Fueros, 3, 31110 Noáin, Navarra' },
            { time: '12:15', label: 'Burlada', place: 'C. Mayor, 80, 31600 Burlada, Navarra' },
        ],
    },
    {
        title: 'Vuelta',
        stops: [{ time: '23:15', label: 'Señorío de Beraiz', place: '' }],
    },
]
---

<section id="bus" class="bg-warm px-4 py-24 sm:py-32">
    <div class="mx-auto max-w-3xl text-center">
        <p class="font-serif text-sm uppercase tracking-[0.3em] text-muted">Transporte</p>
        <h2 class="mt-3 font-serif text-3xl font-normal sm:text-4xl">Autobús</h2>
        <p class="mt-4 text-muted">Os recogeremos para ir todos juntos al lugar de la ceremonia</p>
        <div class="mt-12 space-y-10" data-animate-stagger>
            {trips.map((trip) => (
                <div>
                    <p class="mb-4 text-left font-serif text-2xl text-accent">{trip.title}</p>
                    <div class="space-y-4 text-left">
                        {trip.stops.map((stop) => (
                            <div class="flex items-center gap-6 rounded-lg border border-accent-light/40 bg-white p-6">
                                <div class="card-hover flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent/10">
                                    <span class="font-serif text-lg font-semibold text-accent">{stop.time}</span>
                                </div>
                                <div>
                                    <p class="font-serif text-xl">{stop.label}</p>
                                    {stop.place && <p class="mt-1 text-sm text-muted">{stop.place}</p>}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
