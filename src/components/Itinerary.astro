---
const itinerary = [
    { time: '12:15', label: 'Recogida en Bus', desc: 'Noáin - Burlada' },
    { time: '13:00', label: 'Ceremonia', desc: 'Señorío de Beraiz' },
    { time: '14:00', label: 'Cóctel & Fotos', desc: '' },
    { time: '16:00', label: 'Comida', desc: '' },
    { time: '19:00', label: 'Fiesta', desc: '' },
    { time: '21:00', label: 'Recena', desc: '' },
    { time: '23:15', label: 'Recogida en Bus', desc: 'Hotel 3 Reyes' },
    { time: '23:45', label: 'Llegada Pamplona', desc: 'Hotel 3 Reyes' },
    { time: '00:00', label: 'Zuhaitza', desc: '' },
    { time: '04:00', label: 'Fin', desc: '' },
]

const ROW = 72
const AMP = 45
const CX = 500
const points = []
for (let y = 0; y <= itinerary.length * ROW; y += 10) {
    const x = CX + AMP * Math.sin((2 * Math.PI * (y - ROW / 2)) / (2 * ROW))
    points.push(`${x.toFixed(1)} ${y}`)
}
const pathD = `M ${points.join(' L ')}`
---

<section id="itinerario" class="bg-white px-4 py-24 sm:py-32">
    <div class="mx-auto max-w-3xl">
        <div class="mb-16 text-center" data-animate>
            <p class="font-serif text-sm uppercase tracking-[0.3em] text-muted">Itinerario</p>
            <h2 class="mt-3 font-serif text-3xl font-normal sm:text-4xl">El día</h2>
        </div>
        <div class="relative">
            <svg
                aria-hidden="true"
                class="absolute inset-0 h-full w-full"
                viewBox={`0 0 1000 ${itinerary.length * ROW}`}
                preserveAspectRatio="none"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    id="road-path"
                    d={pathD}
                    pathLength="100"
                    stroke="#dccfc0"
                    stroke-width="14"
                    vector-effect="non-scaling-stroke"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    opacity="0.4"
                    style="stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 2.5s ease-out"
                />
            </svg>
            <div class="relative">
                {itinerary.map((item, i) => {
                    const text = (
                        <div class={item.desc ? 'pt-3' : ''}>
                            <p class="font-serif text-lg sm:text-xl">{item.label}</p>
                            {item.desc && <p class="mt-1 text-sm text-muted">{item.desc}</p>}
                        </div>
                    )
                    const side = i % 2 === 0
                    const badgeShift = side ? '-translate-x-5' : 'translate-x-5'
                    return (
                        <div class="flex items-center" style={`min-height:${ROW}px`}>
                            <div class={`flex w-1/2 ${side ? 'justify-end pr-10 text-right' : ''}`}>{side ? text : null}</div>
                            <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white shadow-sm ring-2 ring-accent-light/50 ${badgeShift}`}>
                                <span class="font-serif text-base font-semibold text-accent">{item.time}</span>
                            </div>
                            <div class={`flex w-1/2 ${side ? '' : 'justify-start pl-10 text-left'}`}>{side ? null : text}</div>
                        </div>
                    )
                })}
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const path = document.getElementById('road-path')
        if (!path) return
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    path.style.strokeDashoffset = '0'
                    observer.disconnect()
                }
            },
            { threshold: 0.1 }
        )
        observer.observe(path)
    })()
</script>
