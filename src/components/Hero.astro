---
import Countdown from './Countdown.astro'

const { title, subtitle, date, targetDate } = Astro.props
---

<section class="relative flex min-h-dvh flex-col overflow-hidden px-4 text-center">
    <div class="absolute inset-0">
        <picture>
            <source srcset="/portada.webp" type="image/webp" />
            <img
                src="/portada.png"
                alt="Ilustración de la boda de Oihane y Fer"
                class="h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
            />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-b from-cream/80 via-cream/50 to-warm/85"></div>
    </div>
    <div class="relative z-10 mx-auto flex w-full max-w-2xl flex-1 flex-col justify-between py-12">
        <div data-animate>
            <p class="font-serif text-sm uppercase tracking-[0.3em] text-muted">Invitación</p>
            <h1 class="mt-6 font-serif text-5xl font-normal leading-tight tracking-wide sm:text-7xl">
                {title}
            </h1>
        </div>
        <div data-animate>
            <div class="mx-auto mb-8 h-px w-20 bg-accent"></div>
            <p class="font-serif text-2xl italic text-accent sm:text-3xl">{subtitle}</p>
            <p class="mt-6 text-lg font-light text-muted">{date}</p>
            <Countdown targetDate={targetDate} />
        </div>
    </div>
</section>
